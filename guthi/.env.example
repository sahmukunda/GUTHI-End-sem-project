# Copy to `.env`. Values are read as OS / process environment variables when you run the API.
#
# MongoDB (matches `spring.data.mongodb.*` in `src/main/resources/application-dev.yml`).
# You can put the database in the URI instead of using SPRING_DATA_MONGODB_DATABASE, e.g.:
#   MONGODB_URI=mongodb://localhost:27017/guthi
MONGODB_URI=mongodb://localhost:27017/guthi
SPRING_DATA_MONGODB_DATABASE=guthi
